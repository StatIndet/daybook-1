{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daybook-1",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-24",

  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daybook-stats",
      "database_id": "e0138258-07cb-482f-ae92-e868462b324a"
    }
  ],

  "observability": {
    "enabled": true
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_PRESENCE",
        "class_name": "SitePresence"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SitePresence"]
    }
  ]
}
